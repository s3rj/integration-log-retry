<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="integration-log-retry"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Apex rules for integration-log-retry.</description>

    <rule ref="category/apex/bestpractices.xml">
        <!-- Tests run as the deploying admin on purpose; there is no second persona to model. -->
        <exclude name="ApexUnitTestClassShouldHaveRunAs"/>
    </rule>
    <rule ref="category/apex/errorprone.xml"/>
    <rule ref="category/apex/performance.xml"/>
    <rule ref="category/apex/security.xml">
        <!-- Integration Logs are system records written by framework code that runs as the automation user;
             the queueable, the sweeper, and the finalizer must be able to read and update them regardless of the
             user's field-level security. Read access for people is granted by the Integration Log Admin permission set. -->
        <exclude name="ApexCRUDViolation"/>
    </rule>
</ruleset>
